+            "w2_weight_scale_2",
+            "w13_input_scale",
+            "w2_input_scale",
+        ):
+            if hasattr(layer, name):
+                delattr(layer, name)
+        self.create_weights(
+            layer,
+            *self._checkpoint_create_weights_args,
+            **self._checkpoint_create_weights_extra,
+        )
