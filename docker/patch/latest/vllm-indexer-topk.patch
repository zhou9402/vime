diff --git a/vllm/model_executor/layers/indexer_topk_capturer.py b/vllm/model_executor/layers/indexer_topk_capturer.py
new file mode 100644
index 0000000000..e07589bc04
--- /dev/null
+++ b/vllm/model_executor/layers/indexer_topk_capturer.py
@@ -0,0 +1,92 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Capture per-token DSA indexer top-k indices for RL rollout replay (R3).
+
+The DSA indexer layers (``SparseAttnIndexer``) share a single reusable
+``topk_indices_buffer`` that every layer overwrites in turn, so a per-layer
+record requires copying each layer's indices right after its forward. The
+capturer owns a ``(max_num_batched_tokens, num_indexer_layers, index_topk)``
+int32 buffer; each bound indexer copies its rows into its own slot.
+
+TP note: indexer top-k is deterministic given the same KV pages, so the buffer
+is captured identically on every TP rank and only the executor output rank's
+copy is consumed downstream.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from functools import partial
+
+import numpy as np
+import torch
+
+from vllm.model_executor.layers.sparse_attn_indexer import SparseAttnIndexer
+
+
+class IndexerTopkCapturer:
+    def __init__(
+        self,
+        max_num_batched_tokens: int,
+        num_indexer_layers: int,
+        index_topk: int,
+        device: torch.device,
+    ) -> None:
+        self.num_indexer_layers = num_indexer_layers
+        self.index_topk = index_topk
+        self.buffer = torch.full(
+            (max_num_batched_tokens, num_indexer_layers, index_topk),
+            -1,
+            dtype=torch.int32,
+            device=device,
+        )
+
+    def capture(self, slot: int, num_tokens: int, topk_indices_buffer: torch.Tensor) -> None:
+        self.buffer[:num_tokens, slot].copy_(topk_indices_buffer[:num_tokens])
+
+
+def bind_indexer_topk_capturer(
+    model: torch.nn.Module, max_num_batched_tokens: int, index_topk: int
+) -> IndexerTopkCapturer:
+    """Assign one buffer slot per SparseAttnIndexer layer, in module order."""
+    indexer_modules = [m for m in model.modules() if isinstance(m, SparseAttnIndexer)]
+    if not indexer_modules:
+        raise RuntimeError(
+            "enable_return_indexer_topk is set but the model has no SparseAttnIndexer layers"
+        )
+    capturer = IndexerTopkCapturer(
+        max_num_batched_tokens=max_num_batched_tokens,
+        num_indexer_layers=len(indexer_modules),
+        index_topk=index_topk,
+        device=indexer_modules[0].topk_indices_buffer.device,
+    )
+    for slot, module in enumerate(indexer_modules):
+        module._indexer_topk_capture = partial(capturer.capture, slot)
+    return capturer
+
+
+@dataclass
+class PendingIndexerTopk:
+    """Own one step's indexer top-k GPU snapshot until its async D2H copy lands."""
+
+    capturer: IndexerTopkCapturer
+    request_ids: list[str]
+    query_start_loc: np.ndarray
+    gpu_slice: torch.Tensor  # view of capturer.buffer[:num_rows]
+    rows: np.ndarray | None = None
+    num_rejected: np.ndarray | None = None
+
+    def enqueue_cpu_copy(self, num_rejected: np.ndarray) -> None:
+        """Enqueue asynchronous D2H copies; call on the output copy stream."""
+        self.num_rejected = num_rejected
+        self.rows = self.gpu_slice.to("cpu", non_blocking=True).numpy()
+
+    def process_output(self) -> dict[str, np.ndarray]:
+        """Per-request rows with the spec-decode-rejected suffix dropped."""
+        assert self.rows is not None and self.num_rejected is not None
+        out: dict[str, np.ndarray] = {}
+        for i, request_id in enumerate(self.request_ids):
+            start, end = int(self.query_start_loc[i]), int(self.query_start_loc[i + 1])
+            keep = max(end - start - int(self.num_rejected[i]), 0)
+            out[request_id] = self.rows[start : start + keep]
+        return out
